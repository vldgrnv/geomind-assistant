# ===== YandexGPT API =====
# Ключ API для YandexGPT (заменить на продакшн-ключ!)
YANDEX_API_KEY=ЗАМЕНИТЕ_НА_ПРОДАКШН_КЛЮЧ
# ID каталога в Yandex Cloud
YANDEX_FOLDER_ID=ЗАМЕНИТЕ_НА_FOLDER_ID

# ===== Авторизация =====
# Секретный ключ для подписи JWT-токенов (ОБЯЗАТЕЛЬНО сменить!)
JWT_SECRET=ЗАМЕНИТЕ_НА_НАДЁЖНЫЙ_СЛУЧАЙНЫЙ_КЛЮЧ
# Время жизни JWT-токена в днях
JWT_EXPIRE_DAYS=30

# ===== Тарифные планы — лимиты запросов в месяц =====
# План Free — бесплатный
PLAN_LIMIT_FREE=10
# План Basic — 490 ₽/мес
PLAN_LIMIT_BASIC=100
# План Pro — 1490 ₽/мес (безлимит)
PLAN_LIMIT_PRO=999999

# ===== Сервер =====
# Порт приложения
APP_PORT=8000
# Режим отладки (false для продакшна!)
DEBUG=false
# Разрешённые origins через запятую
CORS_ALLOW_ORIGINS=https://geomind.ru,https://www.geomind.ru

# ===== База данных =====
# Путь к файлу SQLite (для PostgreSQL: postgresql://user:pass@localhost/geomind)
DATABASE_URL=geomind.db

# ===== ЮKassa (оплата) =====
# ID магазина (получить в личном кабинете ЮKassa)
YUKASSA_SHOP_ID=ЗАМЕНИТЕ_НА_SHOP_ID
# Секретный ключ магазина
YUKASSA_SECRET=ЗАМЕНИТЕ_НА_SECRET_KEY
